{
  "name": "riftfall-duel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c magenta,cyan \"node --watch --import tsx server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "check": "tsc --noEmit",
    "test:multiplayer": "node tests/multiplayer.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "express": "^5.2.1",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
